{
  "$comment": "Phase 0 — General map dataset. Dummy file showing how pinned + custom + categorized markers live together with categories and nested collapses. Marker items match example_pinned|custom|categorized.json.",
  "//version": "Dataset format version. Integer >= 1.",
  "version": 1,
  "//meta": "Optional. Human-facing dataset info (not drawn on the map).",
  "meta": {
    "//id": "Stable dataset id string (storage / selector / sharing).",
    "id": "demo-map",
    "//title": "Short display name.",
    "title": "Demo Map",
    "//description": "Longer summary of the map contents.",
    "description": "Dummy dataset showing all marker kinds and a nested zone."
  },
  "//categories": "Either a path string to a categories file, OR an inline categories object (same shape as example_categories.json).",
  "categories": "./example_categories.json",
  "//points": "Array of mixed-kind marker wrappers (pinned | custom | categorized).",
  "points": [
    {
      "type": "pinned",
      "point": {
        "id": "PIN-DEMO-01",
        "type": "pinned",
        "display_picture": "https://example.com/images/demo-center.png",
        "coordinates": { "lat": 0.0, "lng": 0.0 },
        "point_content": {
          "name": "Demo Map Center",
          "pictures": ["https://example.com/images/demo-center.png"],
          "description": "Pinned: never clusters, excluded from category search.",
          "link": "https://example.com/places/demo-center",
          "includeInCategorySearch": false,
          "isCollapsible": false,
          "isNested": "zone-a.json"
        }
      }
    },
    {
      "type": "custom",
      "point": {
        "id": "CUS-DEMO-01",
        "type": "custom",
        "hasCategory": "photo_stop",
        "display_picture": "https://example.com/images/stop-main.jpg",
        "coordinates": { "lat": 1.5, "lng": -1.5 }
      },
      "point_content": {
        "name": "Demo Photo Stop",
        "pictures": ["https://example.com/images/stop-main.jpg"],
        "description": "Custom: large photo rectangle with priority.",
        "link": "https://example.com/photos/demo-stop",
        "includeInCategorySearch": "photo_stop",
        "isCollapsible": false,
        "priority": 10
      }
    },
    {
      "type": "categorized",
      "point": {
        "id": "CAT-DEMO-01",
        "type": "categorized",
        "categories": ["cafe"],
        "coordinates": { "lat": -10.25, "lng": 20.75 }
      },
      "point_content": {
        "name": "Demo Cafe",
        "picture": [],
        "description": "123 Example Street.",
        "link": "",
        "priority": 0
      }
    },
    {
      "type": "categorized",
      "point": {
        "id": "CAT-DEMO-02",
        "type": "categorized",
        "categories": ["museum"],
        "coordinates": { "lat": -10.3, "lng": 20.8 }
      },
      "point_content": {
        "name": "Demo Museum",
        "picture": ["https://example.com/images/museum-gallery.jpg"],
        "description": "Example of a categorized point using an icon-style category.",
        "link": "https://example.com/museum",
        "priority": 5
      }
    },
    {
      "type": "categorized",
      "point": {
        "id": "CAT-DEMO-03",
        "type": "categorized",
        "categories": ["other"],
        "coordinates": { "lat": -10.4, "lng": 20.9 }
      },
      "point_content": {
        "name": "Demo Landmark",
        "picture": [],
        "description": "Example of a categorized point.",
        "link": "https://example.com/landmark",
        "priority": 0
      }
    }
  ],
  "//collapses": "Object map. Keys = isNested values. Values = nested { polygon, points }.",
  "collapses": {
    "zone-a.json": {
      "polygon": {
        "color": "#ff0000",
        "coordinates": [
          { "lat": 0.01, "lng": -0.01 },
          { "lat": 0.01, "lng": 0.01 },
          { "lat": -0.01, "lng": 0.01 },
          { "lat": -0.01, "lng": -0.01 }
        ]
      },
      "points": [
        {
          "type": "categorized",
          "point": {
            "id": "CAT-ZONE-01",
            "type": "categorized",
            "categories": ["other"],
            "coordinates": { "lat": 0.0, "lng": 0.0 }
          },
          "point_content": {
            "name": "Demo Gate",
            "picture": [],
            "description": "Nested categorized point inside zone-a.",
            "link": "",
            "priority": 0
          }
        }
      ]
    }
  }
}
