# Cloudinary (frontend-safe values only)
# Copy this file to `.env.local` and fill in your account values.
# `.env.local` is gitignored — never commit real keys.

# Required to build delivery URLs and upload images.
# Dashboard → Settings → Product environment credentials → Cloud name
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Required for browser uploads. Create an *unsigned* preset:
# Dashboard → Settings → Upload → Upload presets → Add upload preset
#   Signing mode: Unsigned
#   (optional) Folder: miami-map
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# Optional default folder for uploads (must be allowed by the preset).
VITE_CLOUDINARY_FOLDER=miami-map

# -----------------------------------------------------------------------------
# DO NOT put these in any VITE_ variable — they would be exposed in the browser
# bundle. Use them only on a future backend / Cloudinary signed uploads:
#
#   CLOUDINARY_API_KEY=...
#   CLOUDINARY_API_SECRET=...
# -----------------------------------------------------------------------------
